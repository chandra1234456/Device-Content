<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    app:startDestination="@id/introFragment">

    <!-- INTRO -->
    <fragment
        android:id="@+id/introFragment"
        android:name="com.chandra.practice.deviceinfo.presentation.IntroFragment"
        android:label="Intro"
        tools:layout="@layout/fragment_intro">

        <action
            android:id="@+id/action_intro_to_splash"
            app:destination="@id/splashFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />

        <action
            android:id="@+id/action_intro_to_webView"
            app:destination="@id/webViewFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
    </fragment>

    <!-- SPLASH -->
    <fragment
        android:id="@+id/splashFragment"
        android:name="com.chandra.practice.deviceinfo.presentation.SplashFragment"
        android:label="Splash"
        tools:layout="@layout/fragment_splash">

        <action
            android:id="@+id/action_splash_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
    </fragment>

    <!-- HOME -->
    <fragment
        android:id="@+id/homeFragment"
        android:name="com.chandra.practice.deviceinfo.presentation.DeviceFragment"
        android:label="Home"
        tools:layout="@layout/fragment_device">

        <action
            android:id="@+id/action_home_to_settings"
            app:destination="@id/settingsFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
        <action
            android:id="@+id/action_homeFragment_to_batteryInfoFragment"
            app:destination="@id/batteryInfoFragment" />
        <action
            android:id="@+id/action_homeFragment_to_networkDetailsFragment"
            app:destination="@id/networkDetailsFragment" />
        <action
            android:id="@+id/action_homeFragment_to_appsInfoFragment"
            app:destination="@id/appsInfoFragment" />
    </fragment>

    <!-- SETTINGS -->
    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.chandra.practice.deviceinfo.presentation.SettingsFragment"
        android:label="Settings"
        tools:layout="@layout/fragment_settings" />

    <!-- WEBVIEW -->
    <fragment
        android:id="@+id/webViewFragment"
        android:name="com.chandra.practice.deviceinfo.presentation.WebViewFragment"
        android:label="WebView"
        tools:layout="@layout/fragment_web_view" />
    <fragment
        android:id="@+id/batteryInfoFragment"
        android:name="com.chandra.practice.deviceinfo.features.battery.BatteryInfoFragment"
        tools:layout="@layout/fragment_battery_info"
        android:label="BatteryInfoFragment" />
    <fragment
        android:id="@+id/networkDetailsFragment"
        android:name="com.chandra.practice.deviceinfo.features.network.NetworkDetailsFragment"
        android:label="fragment_network_details"
        tools:layout="@layout/fragment_network_details" />
    <fragment
        android:id="@+id/appsInfoFragment"
        android:name="com.chandra.practice.deviceinfo.features.appsInfo.AppsInfoFragment"
        android:label="fragment_apps_info"
        tools:layout="@layout/fragment_apps_info" />

</navigation>